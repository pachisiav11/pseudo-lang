// Guide section 3.2. The copy is deep: changing one array does not touch the
// other.

DECLARE NoughtsAndCrosses : ARRAY[1:3,1:3] OF CHAR
DECLARE SavedGame : ARRAY[1:3,1:3] OF CHAR

NoughtsAndCrosses[1,1] <- 'O'
SavedGame <- NoughtsAndCrosses
NoughtsAndCrosses[1,1] <- 'X'

OUTPUT SavedGame[1,1]
OUTPUT NoughtsAndCrosses[1,1]
