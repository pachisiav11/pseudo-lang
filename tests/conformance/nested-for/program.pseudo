// Guide section 7.1.

DECLARE Total : ARRAY[1:3] OF INTEGER
DECLARE GrandTotal : INTEGER
DECLARE Row : INTEGER
DECLARE Column : INTEGER
DECLARE Values : ARRAY[1:3,1:3] OF INTEGER

FOR Row <- 1 TO 3
   FOR Column <- 1 TO 3
      Values[Row,Column] <- Row * Column
   NEXT Column
NEXT Row

GrandTotal <- 0
FOR Row <- 1 TO 3
   Total[Row] <- 0
   FOR Column <- 1 TO 3
      Total[Row] <- Total[Row] + Values[Row,Column]
   NEXT Column
   OUTPUT "Total for row ", Row, " is ", Total[Row]
   GrandTotal <- GrandTotal + Total[Row]
NEXT Row

OUTPUT "The grand total is ", GrandTotal
