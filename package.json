{
  "name": "pseudo-lang-workspace",
  "version": "0.2.0",
  "private": true,
  "description": "Cambridge 9618 pseudocode interpreter and VS Code extension",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
